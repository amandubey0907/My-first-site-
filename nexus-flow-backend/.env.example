# =====================================================
# Nexus Flow Backend — Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- MongoDB Connection ---
MONGODB_URI=mongodb://localhost:27017/nexusflow
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/nexusflow?retryWrites=true&w=majority

# --- Server Configuration ---
PORT=4000
NODE_ENV=development

# --- CORS Allowed Origins (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# --- Telemetry Ingestion Settings ---
# Max events per bulk ingest batch
MAX_BATCH_SIZE=500
# TTL for raw telemetry docs in seconds (default: 7 days)
TELEMETRY_TTL_SECONDS=604800
